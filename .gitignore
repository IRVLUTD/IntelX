# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.env

# tooling
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# editors and platforms
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local notes that never ship.
.anonymity-denylist
ANONYMITY.md

# run artefacts. Results are reproduced, not committed.
results/*
!results/.gitkeep
sweep_out/
temp_sweep/
temp_autonomous_exploration/
intelx_ood_test_maps/
*.log
*.mp4
*.avi
decisions.csv
run_data.csv
spawns.json

# The generated coverage data, and any training checkpoint, are reproduced
# rather than committed. See data/README.md and weights/README.md.
*.pth
*.ckpt
*.npz
*.h5
data/coverage/**
!data/coverage/.gitkeep

# Maps are ignored by default, because the full set is far past what a git
# host will take. The ones this release ships are named one by one below, so
# adding a map is a deliberate act and never an accident. The negations come
# last so they win over the patterns above. Git cannot re-include a file whose
# parent directory is excluded, so the directories themselves are re-included
# first; the files in them stay ignored unless they are named.
data/maps/**
!data/maps/**/
!data/maps/**/.gitkeep
!data/maps/real/real_slam_corridor.pgm
!data/maps/test_standardized/small_office3.pgm
!data/maps/ood_test_standardized/aws_maps/hospital.pgm

# Checkpoints are never committed. The trained one is a separate download, see
# weights/README.md.
weights/*
!weights/.gitkeep
!weights/README.md
